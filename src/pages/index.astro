---
import { Image } from 'astro:assets';
import BaseLayout from '../components/BaseLayout.astro';
import PubList from '../components/PubList.astro';
import { getPublications } from '../lib/content';
import { withBase } from '../lib/paths';
import { youtubeLinkAttributes } from '../lib/links';
import news from '../data/news.json';
import projects from '../data/projects.json';
import hero from '../../public/media/engineering-lehigh-edu/title_bendable-lowres.jpg';
import club from '../../public/wp-content/uploads/2024/01/club2023.png';
const recent = (await getPublications()).slice(0, 4);
---
<BaseLayout>
  <section class="border-b border-primary-100 bg-primary-50">
    <div class="container-page pt-14 pb-10 sm:pt-20 sm:pb-14">
      <p class="text-xs font-semibold tracking-[0.18em] text-primary-700 uppercase">Lehigh University · Robotics Laboratory</p>
      <div class="mt-7 grid items-end gap-8 lg:grid-cols-[1.15fr_1fr] lg:gap-20">
        <h1 class="max-w-2xl font-serif text-5xl leading-[1.05] tracking-tight sm:text-6xl lg:text-7xl">We work with robots.<br /><span class="text-primary-700">Lots of robots.</span></h1>
        <div class="pb-1">
          <p class="max-w-xl text-base leading-relaxed text-slate-600 sm:text-lg">We develop cooperative aerial robots that assemble, manipulate, and work together. Exploring what becomes possible when robots act as a swarm.</p>
          <div class="mt-7 flex flex-wrap gap-3">
            <a href={withBase('/research/')} class="rounded-md bg-primary-700 px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-primary-900">Explore our research <span aria-hidden="true">↗</span></a>
            <a href={withBase('/people/')} class="rounded-md border border-primary-200 px-5 py-3 text-sm font-semibold text-primary-800 transition-colors hover:bg-white">Meet the team</a>
          </div>
        </div>
      </div>
      <figure class="mt-10 overflow-hidden rounded-xl border border-primary-200 bg-white sm:mt-12">
        <Image src={hero} alt="A pair of aerial robots cooperatively bending a flexible object in flight" widths={[640, 1100, 1600]} sizes="(min-width: 1152px) 1088px, 95vw" loading="eager" fetchpriority="high" class="aspect-[16/7] w-full object-cover" />
        <figcaption class="flex flex-wrap items-center justify-between gap-2 border-t border-primary-100 px-5 py-3 text-xs text-slate-600">
          <span>Cooperative aerial manipulation · SwarmsLab</span>
          <a href={news[0].url} {...youtubeLinkAttributes(news[0].url)} class="font-semibold text-primary-700 hover:underline">Our NSF CAREER research <span aria-hidden="true">↗</span></a>
        </figcaption>
      </figure>
    </div>
  </section>
  <section class="container-page py-14 sm:py-20">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div><p class="eyebrow">Robots working together</p><h2 class="mt-3 font-serif text-3xl sm:text-4xl">From individual robots to collective capability.</h2></div>
      <a href={withBase('/research/')} class="text-sm font-semibold text-primary-700 hover:underline">All research <span aria-hidden="true">→</span></a>
    </div>
    <div class="mt-9 grid gap-7 md:grid-cols-3">
      {projects.map((p,i)=>(<a href={withBase('/research/#'+p.slug)} class="group block">
        <div class="overflow-hidden rounded-lg border border-slate-200 bg-slate-50"><img src={withBase(p.image)} alt={p.title} width="640" height="420" loading="lazy" class="aspect-[3/2] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]" /></div>
        <p class="mt-5 text-xs font-medium tracking-wider text-primary-700 uppercase">0{i+1} / {p.subtitle}</p>
        <h3 class="mt-2 font-serif text-2xl group-hover:text-primary-700">{p.title}</h3>
        <p class="mt-3 text-sm leading-relaxed text-slate-600">{['Flying modules that self-assemble and adapt their shape and capabilities to the task.','Teams of aerial robots that carry, grasp, and manipulate through physical interaction.','Reliable coordination even when individual robots fail or share incorrect information.'][i]}</p>
      </a>))}
    </div>
  </section>
  <section class="border-y border-slate-200 bg-slate-50">
    <div class="container-page py-14 sm:py-16">
      <div class="flex items-end justify-between gap-4"><div><p class="eyebrow">Around the lab</p><h2 class="mt-3 font-serif text-3xl">News & highlights</h2></div><a href={withBase('/news/')} class="text-sm font-semibold text-primary-700 hover:underline">All news →</a></div>
      <div class="mt-8 grid gap-7 md:grid-cols-3">{news.slice(0,3).map(n=>(<article class="overflow-hidden rounded-xl border border-slate-200 bg-white">
        <a href={n.url} {...youtubeLinkAttributes(n.url)} class="group block"><img src={withBase(n.image)} alt="" width="640" height="427" loading="lazy" class="aspect-[16/10] w-full object-cover" /><div class="p-6"><h3 class="font-serif text-xl leading-snug group-hover:text-primary-700">{n.title}</h3><p class="mt-3 text-sm leading-relaxed text-slate-600">{n.body}</p><span class="mt-5 inline-block text-xs font-semibold text-primary-700">Read the story ↗</span></div></a>
      </article>))}</div>
    </div>
  </section>
  <section class="container-page py-14 sm:py-16">
    <div class="mb-5 flex items-end justify-between gap-4"><div><p class="eyebrow">Research in print</p><h2 class="mt-3 font-serif text-3xl">Recent publications</h2></div><a href={withBase('/publications/')} class="text-sm font-semibold text-primary-700 hover:underline">All publications →</a></div>
    <PubList pubs={recent} />
  </section>
  <section class="container-page">
    <div class="grid overflow-hidden rounded-xl border border-primary-100 bg-primary-50 lg:grid-cols-2">
      <Image src={club} alt="Lehigh Swarms students and mentors together at a robotics competition" widths={[600, 1000]} sizes="(min-width: 1024px) 50vw, 95vw" class="h-full min-h-64 w-full object-cover" />
      <div class="p-8 sm:p-12"><p class="eyebrow">Build. Fly. Collaborate.</p><h2 class="mt-4 font-serif text-3xl">A place to learn by doing.</h2><p class="mt-4 text-base leading-relaxed text-slate-600">The Lehigh Aerial Swarms Club brings students together to build autonomous robots, develop new skills, and take on the Defend the Republic competition.</p><a href={withBase('/club/')} class="mt-7 inline-block text-sm font-semibold text-primary-700 hover:underline">Explore the club →</a></div>
    </div>
  </section>
</BaseLayout>
