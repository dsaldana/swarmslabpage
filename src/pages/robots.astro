---
import { Image } from 'astro:assets';
import BaseLayout from '../components/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import robots from '../data/robots.json';
import { getPublications, type Publication } from '../lib/content';
import { withBase } from '../lib/paths';

const publications=new Map((await getPublications()).map(p=>[p.id,p]));
const isYouTube=(url:string)=>/^https:\/\/(?:www\.)?(?:youtube\.com|youtu\.be)\//.test(url);
function paperLink(paper:Publication){
  const d=paper.data;
  return d.doi?`https://doi.org/${d.doi}`
    :d.resources.find(r=>r.label==='PDF')?.url
    ??(d.url&&!isYouTube(d.url)?d.url:undefined)
    ??d.scholarUrl;
}
const entries=[...robots].sort((a,b)=>a.year-b.year).map(robot=>{
  const imagePaper=publications.get(robot.imagePaper);
  if(!imagePaper?.data.image)throw new Error(`Missing robot image: ${robot.slug}`);
  const papers=robot.papers.map(id=>{
    const paper=publications.get(id);
    if(!paper||!paperLink(paper))throw new Error(`Missing robot paper or link: ${id}`);
    return paper;
  });
  const video=papers.flatMap(p=>p.data.resources).find(r=>isYouTube(r.url));
  return {...robot,image:imagePaper.data.image,alt:robot.imageAlt??imagePaper.data.imageAlt??robot.name,papers,video};
});
---

<BaseLayout title="Our Robots" description="Explore SwarmsLab's robots, from self-assembling quadrotors to robotic blimps and cooperative aerial manipulation systems, with papers and videos.">
  <PageHeader eyebrow="Platforms we develop" title="Our Robots" lead="Meet the robots behind our research: aerial systems that assemble, jump, swing, grasp, and work together." />
  <div class="container-page pb-16">
    <ol class="divide-y divide-slate-200">
      {entries.map((robot,index)=><li>
        <article id={robot.slug} data-robot data-year={robot.year} aria-labelledby={`${robot.slug}-title`} class="scroll-mt-24 grid gap-7 py-10 md:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] md:gap-10 lg:gap-14">
          <div class="aspect-[3/2] overflow-hidden rounded-xl md:self-start">
            <Image src={robot.image} alt={robot.alt} widths={[400,640,880]} sizes="(min-width: 1152px) 400px, (min-width: 768px) 38vw, calc(100vw - 32px)" width={880} class="h-full w-full object-cover" loading={index===0?'eager':'lazy'} decoding="async" data-robot-image />
          </div>
          <div class="min-w-0">
            <p class="eyebrow" data-robot-year>{robot.endYear?`${robot.year}–${robot.endYear}`:robot.year}</p>
            <h2 id={`${robot.slug}-title`} class="mt-2 font-serif text-3xl sm:text-4xl">{robot.name}</h2>
            <p class="mt-4 max-w-2xl leading-relaxed text-slate-600">{robot.description}</p>
            {robot.video&&<a href={robot.video.url} target="_blank" rel="noopener noreferrer" class="mt-5 inline-flex items-center gap-2 rounded-md border border-primary-200 bg-primary-50 px-4 py-2 text-sm font-semibold text-primary-700 transition-colors hover:border-primary-400 hover:bg-primary-100" data-robot-video>
              <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4"><path d="M8 5v14l11-7z" /></svg>
              Watch on YouTube <span aria-hidden="true">↗</span>
            </a>}
            <div class="mt-6 border-t border-slate-200 pt-5">
              <h3 class="font-sans text-xs font-semibold uppercase tracking-wider text-slate-500">Associated papers</h3>
              <ul class="mt-3 space-y-3">
                {robot.papers.map(p=><li class="flex items-baseline gap-3 text-sm leading-relaxed"><span class="shrink-0 text-xs tabular-nums text-slate-400">{p.data.year}</span><a href={withBase(paperLink(p)!)} data-robot-paper={p.id} class="text-primary-700 underline-offset-4 hover:underline">{p.data.title} <span aria-hidden="true">↗</span></a></li>)}
              </ul>
            </div>
          </div>
        </article>
      </li>)}
    </ol>
  </div>
</BaseLayout>
