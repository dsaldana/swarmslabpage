---
import BaseLayout from '../components/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import PubList from '../components/PubList.astro';
import { getPublications, AREA_LABELS, getAreaCounts, type AreaSlug } from '../lib/content';
const pubs=await getPublications();
const counts=await getAreaCounts();
const areas=Object.keys(counts) as AreaSlug[];
const years=[...new Set(pubs.map(p=>p.data.year))];
---
<BaseLayout title="Publications" description="Publications from SwarmsLab on aerial robotics, modular robots, cooperative manipulation, and resilient multi-robot systems.">
  <PageHeader eyebrow="Research output" title="Publications" lead="Explore our work in aerial robotics and multi-robot systems. Search by title, author, or venue, and filter by research area, year, and publication type." />
  <div class="container-page py-10">
    <form id="publication-filters" role="search" class="rounded-xl border border-slate-200 bg-slate-50 p-5" onsubmit="return false">
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-[2fr_1fr_1fr]">
        <label class="text-xs font-semibold text-slate-600">Search publications<input id="pub-search" type="search" placeholder="Title, author, or venue…" class="mt-2 block w-full rounded-md border border-slate-300 bg-white px-3 py-2.5 text-sm font-normal" /></label>
        <label class="text-xs font-semibold text-slate-600">Year<select id="pub-year" class="mt-2 block w-full rounded-md border border-slate-300 bg-white px-3 py-2.5 text-sm font-normal"><option value="all">All years</option>{years.map(y=><option value={y}>{y}</option>)}</select></label>
        <label class="text-xs font-semibold text-slate-600">Publication type<select id="pub-type" class="mt-2 block w-full rounded-md border border-slate-300 bg-white px-3 py-2.5 text-sm font-normal"><option value="all">All types</option><option value="conference">Conference papers</option><option value="journal">Journal articles</option><option value="chapter">Book chapters</option><option value="thesis">Theses</option><option value="workshop">Workshop abstracts</option><option value="report">Technical reports</option><option value="other">Other publications</option></select></label>
      </div>
      <fieldset class="mt-5"><legend class="mb-2 text-xs font-semibold text-slate-600">Research area</legend><div class="flex flex-wrap gap-2"><button type="button" data-area="all" aria-pressed="true" class="filter-chip">All areas</button>{areas.map(a=><button type="button" data-area={a} aria-pressed="false" class="filter-chip">{AREA_LABELS[a]} <span class="opacity-65">{counts[a]}</span></button>)}</div></fieldset>
      <div class="mt-5 flex items-center justify-between gap-4"><p id="pub-count" role="status" aria-live="polite" class="text-sm text-slate-600">{pubs.length} publications</p><button type="reset" class="text-xs font-medium text-primary-700 hover:underline">Clear filters</button></div>
    </form>
    <PubList pubs={pubs} />
    <p id="pub-empty" hidden class="py-16 text-center text-slate-600">No publications match your filters. Try a different search or clear the filters.</p>
  </div>
</BaseLayout>
<script>
const form=document.querySelector<HTMLFormElement>('#publication-filters')!;
const search=document.querySelector<HTMLInputElement>('#pub-search')!;
const year=document.querySelector<HTMLSelectElement>('#pub-year')!;
const type=document.querySelector<HTMLSelectElement>('#pub-type')!;
const items=[...document.querySelectorAll<HTMLElement>('[data-pub]')];
const buttons=[...document.querySelectorAll<HTMLButtonElement>('[data-area]')];
let area='all';
const norm=(s:string)=>s.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase();
function apply(){
 const words=norm(search.value).trim().split(/\s+/).filter(Boolean); let n=0;
 for(const li of items){const show=(area==='all'||li.dataset.areas?.split(' ').includes(area))&&(year.value==='all'||li.dataset.year===year.value)&&(type.value==='all'||li.dataset.type===type.value)&&words.every(w=>norm(li.dataset.search??'').includes(w));li.hidden=!show;if(show)n++;}
 document.querySelector('#pub-count')!.textContent=`${n} of ${items.length} publications`;
 (document.querySelector('#pub-empty') as HTMLElement).hidden=n>0;
 for(const b of buttons)b.setAttribute('aria-pressed',String(b.dataset.area===area));
}
for(const b of buttons)b.addEventListener('click',()=>{area=b.dataset.area??'all';apply();});
form.addEventListener('input',apply);
form.addEventListener('change',apply);
form.addEventListener('reset',()=>{area='all';requestAnimationFrame(apply);});
function readLocation(){let hash='';try{hash=decodeURIComponent(location.hash.slice(1));}catch{/* Ignore malformed old fragments. */}area=buttons.some(b=>b.dataset.area===hash)?hash:'all';const t=new URLSearchParams(location.search).get('type');if(t&&[...type.options].some(o=>o.value===t))type.value=t;apply();}
window.addEventListener('hashchange',readLocation);readLocation();
</script>
<style>
@reference "../styles/global.css";
.filter-chip { @apply rounded-full border border-slate-300 bg-white px-3 py-1.5 text-xs font-medium text-slate-600 transition-colors; }
.filter-chip[aria-pressed="true"] { @apply border-primary-700 bg-primary-700 text-white; }
</style>
