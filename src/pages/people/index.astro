---
import BaseLayout from "../../components/BaseLayout.astro";
import PersonGroup from "../../components/PersonGroup.astro";
import { getGroupedPeople } from "../../lib/content";

const groups = await getGroupedPeople();
---

<BaseLayout
  title="Team"
  description="Faculty, researchers, and alumni of the lab."
>
  <h1 class="sr-only">Team</h1>
  <div class="container-page py-12">
    {groups.map((g) => <PersonGroup title={g.group} people={g.people} />)}
  </div>
</BaseLayout>
