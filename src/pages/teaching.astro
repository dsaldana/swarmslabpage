---
import BaseLayout from '../components/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import VideoCard from '../components/VideoCard.astro';
import { withBase } from '../lib/paths';

const videos = [
  { id: 'godSD-66_Jg', title: 'Learning to Fly Autonomous Robots - Spring 2024 Mobile Robotics', project: 'Mobile Robotics / Spring 2024' },
  { id: 'BvhfIvI1ynw', title: 'Duckie Rescue Challenge 2023', project: 'Student projects / 2023' },
];
---
<BaseLayout title="Teaching" description="Robotics courses and student projects at Lehigh University, from autonomous flight to hands-on robotics challenges.">
  <PageHeader eyebrow="Learning robotics" title="Teaching" lead="Robotics courses and hands-on research opportunities at Lehigh University." />
  <div class="container-page py-12">
    <section aria-labelledby="student-projects-title">
      <h2 id="student-projects-title" class="font-serif text-3xl sm:text-4xl">Student projects in action</h2>
      <div class="mt-8 grid gap-x-8 gap-y-10 md:grid-cols-2">
        {videos.map(video => <VideoCard video={video} />)}
      </div>
    </section>
    <section aria-labelledby="courses-title" class="mt-12 border-t border-slate-200 pt-12">
      <h2 id="courses-title" class="font-serif text-3xl sm:text-4xl">Courses</h2>
      <ul class="mt-6 space-y-4 text-slate-700">
        <li>CSE360 — Mobile Robotics</li>
        <li>CSE398 — Advanced Aerial Robotics</li>
        <li>CSE398 — Robot Swarms</li>
        <li>Independent Studies</li>
      </ul>
      <p class="mt-8 max-w-2xl text-slate-600">For robotics club activities, summer research opportunities, and ways to get involved, visit the <a href={withBase('/club/')} class="text-primary-700 underline">Lehigh Aerial Swarms Club</a>.</p>
    </section>
  </div>
</BaseLayout>
