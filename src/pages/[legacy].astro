---
import redirects from '../data/redirects.json';
import { withBase } from '../lib/paths';
export function getStaticPaths() {
  return Object.entries(redirects).map(([legacy, target]) => ({params:{legacy}, props:{target}}));
}
const target=withBase(Astro.props.target);
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>Page moved · SwarmsLab</title><meta http-equiv="refresh" content={`0;url=${target}`} /><link rel="canonical" href={new URL(target,Astro.site).href} /><meta name="robots" content="noindex" /></head><body><p>This page has moved. <a href={target}>Continue to SwarmsLab.</a></p></body></html>
