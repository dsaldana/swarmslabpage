---
import { withBase } from '../lib/paths';
interface Props {
  video: { id: string; title: string; project: string; robot?: string };
  paper?: { title: string; url: string };
  featured?: boolean;
}
const { video, paper, featured=false }=Astro.props;
const Heading=featured?'h2':'h3';
const youtube=`https://www.youtube.com/watch?v=${video.id}`;
---
<article data-video-id={video.id} class:list={['min-w-0',featured&&'grid items-center gap-6 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)] lg:gap-10']}>
  <lab-video data-video-id={video.id} data-title={video.title} class="block aspect-video overflow-hidden rounded-xl bg-slate-900">
    <a href={youtube} target="_blank" rel="noopener noreferrer" data-video-play aria-label={`Play ${video.title}`} class="group relative block h-full w-full focus-visible:outline-4 focus-visible:outline-offset-[-4px] focus-visible:outline-primary-300">
      <img src={`https://i.ytimg.com/vi/${video.id}/hqdefault.jpg`} alt="" width="480" height="360" loading={featured?'eager':'lazy'} decoding="async" class="h-full w-full object-cover transition-opacity group-hover:opacity-80" />
      <span class="absolute inset-0 flex items-center justify-center bg-black/10" aria-hidden="true"><span class="flex h-14 w-14 items-center justify-center rounded-full bg-white/95 text-primary-700 shadow-lg transition-transform group-hover:scale-110"><svg viewBox="0 0 24 24" fill="currentColor" class="ml-1 h-7 w-7"><path d="M8 5v14l11-7z" /></svg></span></span>
    </a>
  </lab-video>
  <div class:list={[!featured&&'mt-4']}>
    <p class="eyebrow">{featured?'Featured / Lehigh Engineering':video.project}</p>
    <Heading class:list={['mt-2 font-serif leading-snug',featured?'text-3xl sm:text-4xl':'text-xl']}>{video.title}</Heading>
    {featured&&<p class="mt-4 max-w-lg leading-relaxed text-slate-600">Meet the researchers behind our cooperative aerial robots and see how they work together to manipulate and transport objects.</p>}
    <div class="mt-4 flex flex-wrap gap-x-5 gap-y-2 text-xs font-semibold text-primary-700">
      <a href={youtube} target="_blank" rel="noopener noreferrer" class="hover:underline">Watch on YouTube ↗</a>
      {video.robot&&<a href={withBase(`/robots/#${video.robot}`)} class="hover:underline">Meet the robot →</a>}
      {paper&&<a href={withBase(paper.url)} title={paper.title} class="hover:underline">Related paper ↗</a>}
    </div>
  </div>
</article>

<script>
  class LabVideo extends HTMLElement {
    connectedCallback() {
      const play=this.querySelector<HTMLAnchorElement>('[data-video-play]');
      play?.addEventListener('click',event=>{
        if(event.metaKey||event.ctrlKey||event.shiftKey||event.altKey)return;
        event.preventDefault();
        const frame=document.createElement('iframe');
        frame.src=`https://www.youtube-nocookie.com/embed/${this.dataset.videoId}?autoplay=1&rel=0`;
        frame.title=this.dataset.title??'SwarmsLab video';
        frame.allow='accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
        frame.referrerPolicy='strict-origin-when-cross-origin';
        frame.allowFullscreen=true;
        frame.className='h-full w-full border-0';
        frame.tabIndex=0;
        this.replaceChildren(frame);
        frame.focus();
      });
    }
  }
  if(!customElements.get('lab-video'))customElements.define('lab-video',LabVideo);
</script>
