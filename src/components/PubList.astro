---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import type { Publication } from '../lib/content';
import { authorIsPerson, personKey } from '../lib/content';
import { withBase } from '../lib/paths';
import { isYouTubeUrl, youtubeLinkAttributes } from '../lib/links';
interface Props { pubs: Publication[]; }
const { pubs } = Astro.props;
const people = await getCollection('people');
const dir = people.map(p=>({slug:p.id,key:personKey(p.data.name)}));
const typeLabels = { journal:'Journal article', conference:'Conference paper', chapter:'Book chapter', thesis:'Master’s thesis', workshop:'Workshop extended abstract', report:'Technical report', other:'Publication' };
---
<ol class="divide-y divide-slate-200" data-pub-list>
  {pubs.map(p=>{
    const d=p.data;
    const link=d.doi?`https://doi.org/${d.doi}`:(d.resources.find(r=>r.label==='PDF')?.url ?? d.url ?? d.scholarUrl);
    const ImageLink=link?'a':'div';
    return <li class="py-6" data-pub data-pub-id={p.id} data-year={d.year} data-type={d.publicationType} data-areas={d.areas.join(' ')} data-search={`${d.title} ${d.authors.join(' ')} ${d.journal ?? ''}`.toLowerCase()}>
      <div class:list={['grid items-start gap-5 sm:gap-7', d.image && 'sm:grid-cols-[220px_minmax(0,1fr)]']}>
      {d.image && <ImageLink href={link ? withBase(link) : undefined} {...youtubeLinkAttributes(link)} class="block aspect-[4/3] w-full max-w-xs overflow-hidden rounded-lg border border-slate-200 bg-white p-2 transition-colors hover:border-primary-300 sm:w-[220px]" aria-label={link ? `Read ${d.title}` : undefined}>
        <Image src={d.image} alt={d.imageAlt ?? `Representative image for ${d.title}`} widths={[320, 480, 640]} sizes="(min-width: 640px) 220px, (min-width: 380px) 320px, calc(100vw - 48px)" width={640} class="h-full w-full object-contain" loading="lazy" decoding="async" data-pub-image />
      </ImageLink>}
      <div class="min-w-0">
      <div class="flex items-baseline gap-3 text-xs"><span class="font-semibold text-primary-700">{d.year}</span><span class="text-slate-500">{typeLabels[d.publicationType]}</span></div>
      <h3 class="mt-2 font-sans text-base leading-relaxed font-semibold text-slate-900">{link?<a href={withBase(link)} {...youtubeLinkAttributes(link)} class="hover:text-primary-700 hover:underline">{d.title}</a>:d.title}</h3>
      <p class="mt-2 text-sm leading-relaxed text-slate-600">{d.authors.map((a,i)=>{const person=dir.find(p=>authorIsPerson(a,p.key));return <span>{i>0 && ', '}{person?<a href={withBase(`/people/${person.slug}/`)} class="text-slate-800 hover:text-primary-700 hover:underline">{a}</a>:a}</span>;})}</p>
      {d.journal && <p class="mt-1 text-sm text-slate-500"><em>{d.journal}</em></p>}
      {d.publicationNote && <p class="mt-1 text-xs leading-relaxed text-slate-500">{d.publicationNote}</p>}
      <div class="mt-3 flex flex-wrap gap-x-4 gap-y-2 text-xs font-medium text-primary-700">
        {d.doi && <a href={`https://doi.org/${d.doi}`} class="hover:underline">DOI ↗</a>}
        {d.scholarUrl && <a href={d.scholarUrl} class="hover:underline">Google Scholar ↗</a>}
        {d.resources.map(r=><a href={withBase(r.url)} {...youtubeLinkAttributes(r.url)} class="hover:underline">{isYouTubeUrl(r.url) ? 'YouTube' : r.label} ↗</a>)}
      </div>
      {d.abstract && <details class="mt-3 text-sm"><summary class="w-fit text-primary-700">Abstract</summary><p class="mt-2 max-w-4xl leading-relaxed text-slate-600">{d.abstract}</p></details>}
      {d.bibtex && <details class="mt-2 text-sm"><summary class="w-fit text-primary-700">BibTeX</summary><pre class="mt-2 max-h-80 overflow-auto rounded-md bg-slate-50 p-4 text-xs whitespace-pre-wrap break-words">{d.bibtex}</pre></details>}
      </div>
      </div>
    </li>;
  })}
</ol>
